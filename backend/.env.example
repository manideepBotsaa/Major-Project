# --- Core -------------------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-secret
# Use an absolute path if you run the app from a different directory.
DATABASE_URL=sqlite:///finance.db
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false

# --- Encryption at rest -----------------------------------------------------
# Required before storing real data. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# A long random passphrase also works; it is stretched with SHA-256.
FIELD_ENCRYPTION_KEY=

# --- Demo -------------------------------------------------------------------
ALLOW_DEMO_LOGIN=true
AUTO_SEED_LITERACY=true
DEMO_EMAIL=demo@clearpath.app
DEMO_PASSWORD=DemoPass123!

# --- Advisor (optional) -----------------------------------------------------
# auto selects Gemini when GEMINI_API_KEY is set, otherwise OpenAI-compatible
# when LLM_BASE_URL is set, otherwise the offline deterministic provider.
LLM_PROVIDER=auto
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_TIMEOUT_SECONDS=25
LLM_REQUIRE_NUMERIC_VERIFICATION=true
LLM_SEND_RAW_TRANSACTIONS=false

# Gemini example:
# GEMINI_API_KEY=your-key
# GEMINI_MODEL=gemini-2.0-flash

# Any OpenAI-compatible endpoint, including local Ollama:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1

# --- Limits -----------------------------------------------------------------
LOGIN_RATE_LIMIT=10
CHAT_RATE_LIMIT=40

# --- Research ---------------------------------------------------------------
# RESEARCH_AS_OF=2026-10-28
